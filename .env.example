# ---- Public site (tiiny.host) ------------------------------------------------
# Public URL of the static site. Used for canonical URLs, sitemap.xml, OG/Twitter tags.
# Must match the link name you choose on tiiny.host (or your custom domain).
SITE_URL=https://airlinesgrouptravel.tiiny.site
# tiiny.host site to update through the API (defaults to the host of SITE_URL).
TIINY_DOMAIN=airlinesgrouptravel.tiiny.site
# API key from tiiny.host → Manage Account. API access needs the Solo plan or higher;
# on the free plan leave it empty and use "Download site ZIP" in the admin.
TIINY_API_KEY=
# Publish to tiiny.host automatically every time a post is saved/deleted (needs TIINY_API_KEY).
AUTO_PUBLISH=false

# ---- Lead capture ----------------------------------------------------------------
# PUBLIC HTTPS URL of this server's /api/leads endpoint. The form on the live site posts here,
# so this server must be reachable from the internet (VPS, Render, Railway, Fly.io, tunnel…).
LEAD_ENDPOINT=http://localhost:3000/api/leads
# Extra origins allowed to post leads (comma separated). SITE_URL's origin is always allowed.
ALLOWED_ORIGINS=

# ---- Admin portal ------------------------------------------------------------------
PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Random string used to sign admin sessions: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Set to 1 (or the proxy hop count) when running behind a reverse proxy such as nginx/Caddy/Render.
TRUST_PROXY=loopback
